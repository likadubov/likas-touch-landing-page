---
import SectionHeading from "./SectionHeading.astro";

const projects = [
  {
    name: "סטודיו קרמיקה — נועה כהן",
    category: "דף נחיתה",
    palette: "from-pink/25 via-violet/15 to-transparent",
  },
  {
    name: "קליניקת טיפוח — פנים אל פנים",
    category: "עיצוב לרשתות חברתיות",
    palette: "from-violet/25 via-cyan/10 to-transparent",
  },
  {
    name: "מספרת בוטיק — האחת",
    category: "אוטומציית לידים",
    palette: "from-cyan/20 via-pink/15 to-transparent",
  },
  {
    name: "מאמנת עסקית — לירון שני",
    category: "דף נחיתה + מודעות",
    palette: "from-pink/20 via-violet/20 to-transparent",
  },
];
---

<section id="work" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading
      eyebrow="עבודות נבחרות"
      title="פרויקטים שנולדו מתוך שיתוף פעולה קרוב"
      subtitle="כל פרויקט הוא הזדמנות לבנות מותג מהיסוד — בהמשך יתעדכן כאן תיק עבודות מלא. בינתיים, הנה טעימה מסוג הפרויקטים שמתאימים לי."
    />

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {projects.map((project, i) => (
        <div
          class:list={["corner-frame reveal group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-3xl border border-white/10 bg-noir-3 shadow-card", i % 2 === 1 && "reveal-delay-1", i >= 2 && "reveal-delay-2"]}
        >
          <div class:list={["absolute inset-0 bg-gradient-to-br transition-transform duration-700 group-hover:scale-110", project.palette]}></div>
          <div class="absolute inset-0 bg-grid opacity-40"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="font-mono text-6xl font-bold text-white/[0.06] transition-transform duration-700 group-hover:scale-110 sm:text-7xl">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>

          <div class="absolute inset-0 flex items-center justify-center bg-noir/0 opacity-0 backdrop-blur-0 transition-all duration-500 group-hover:bg-noir/80 group-hover:opacity-100 group-hover:backdrop-blur-sm">
            <span class="translate-y-3 rounded-full border border-pink/40 px-5 py-2 font-mono text-xs font-semibold text-pink-soft transition-transform duration-500 group-hover:translate-y-0">
              קייס סטאדי בקרוב
            </span>
          </div>

          <div class="relative z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-noir via-noir/40 to-transparent p-6 pt-16">
            <div>
              <p class="font-mono text-xs font-semibold uppercase tracking-wide text-pink-soft">{`// ${project.category}`}</p>
              <h3 class="mt-1 text-lg font-bold text-paper sm:text-xl">{project.name}</h3>
            </div>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-paper transition-transform duration-500 group-hover:-translate-y-1 group-hover:rotate-45 group-hover:border-pink/40 group-hover:text-pink-soft">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8 21 12M21 12 17 16M21 12H3" />
              </svg>
            </span>
          </div>
        </div>
      ))}
    </div>

    <p class="reveal mt-10 text-center text-sm text-muted">
      * הפרויקטים המוצגים הם דוגמאות המחשה לסוג העבודות — תיק עבודות מלא בקרוב.
    </p>
  </div>
</section>
