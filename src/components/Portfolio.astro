---
import { Image } from "astro:assets";
import engraving3d from "../assets/portfolio/engraving3d-website.png";
import saritBaking from "../assets/portfolio/sarit-baking.png";
import laser3dFlyer from "../assets/portfolio/laser3d-flyer.webp";
import likasTouchPromo from "../assets/portfolio/likas-touch-promo.webp";

const groups = [
  {
    label: "דפי נחיתה",
    items: [
      {
        name: "Engraving3D Israel",
        category: "בניית אתר תדמית",
        image: engraving3d,
        href: "https://www.engraving3d.co.il/",
        aspect: "1280 / 1000",
      },
      {
        name: "יונית יון — סדנאות אפייה",
        category: "בניית דף נחיתה",
        image: saritBaking,
        href: "https://zestful-keep-417534.framer.app/sarit-baking-workshops",
        aspect: "1280 / 900",
      },
    ],
  },
  {
    label: "מודעות",
    items: [
      {
        name: "Laser 3D",
        category: "עיצוב פלייר לחריטת קריסטל",
        image: laser3dFlyer,
        aspect: "1284 / 1783",
      },
      {
        name: "Lika's Touch",
        category: "עיצוב מודעה ממומנת",
        image: likasTouchPromo,
        aspect: "1122 / 1402",
      },
    ],
  },
];
---

<section id="work" class="relative overflow-hidden py-24 sm:py-32">
  <h2 class="sr-only">עבודות נבחרות</h2>
  <div class="pointer-events-none absolute inset-0 -z-20 bg-grid opacity-60"></div>
  <div class="scan-beam -z-20"></div>
  <div
    class="pointer-events-none absolute -top-20 -start-24 -z-10 h-72 w-72 rounded-full bg-violet/15 blur-3xl animate-float-slow sm:h-96 sm:w-96"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -end-20 -z-10 h-72 w-72 rounded-full bg-pink/15 blur-3xl animate-float-slower sm:h-96 sm:w-96"
  ></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    {groups.map((group, gi) => (
      <div class:list={[gi > 0 && "mt-16"]}>
        <div class="reveal flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-pink shadow-[0_0_8px_var(--color-pink)]"></span>
          <span class="font-mono text-lg font-semibold uppercase tracking-[0.1em] text-pink-soft sm:text-xl">
            {group.label}
          </span>
        </div>

        <div class="mt-6 grid items-start gap-6 sm:grid-cols-2">
          {group.items.map((project, i) => {
            const Tag = project.href ? "a" : "article";
            const linkProps = project.href
              ? { href: project.href, target: "_blank", rel: "noopener noreferrer" }
              : {};
            return (
              <Tag
                {...linkProps}
                class:list={["corner-frame reveal group relative flex w-full flex-col overflow-hidden rounded-3xl border border-white/10 bg-noir-3 shadow-card", i % 2 === 1 && "reveal-delay-1"]}
              >
                <div class="relative w-full overflow-hidden" style={{ aspectRatio: project.aspect }}>
                  <Image
                    src={project.image}
                    alt={`${project.name} — ${project.category}`}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 640px) 50vw, 100vw"
                  />
                  <div class="absolute inset-0 bg-grid opacity-20"></div>
                </div>

                <div class="relative z-10 flex items-center justify-between gap-3 border-t border-white/10 p-6">
                  <div>
                    <p class="font-mono text-sm font-semibold uppercase tracking-wide text-pink-soft">{`// ${project.category}`}</p>
                    <h3 class="mt-1 text-lg font-bold text-paper sm:text-xl">{project.name}</h3>
                  </div>
                  {project.href && (
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-paper transition-transform duration-500 group-hover:-translate-y-1 group-hover:rotate-45 group-hover:border-pink/40 group-hover:text-pink-soft">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8 21 12M21 12 17 16M21 12H3" />
                      </svg>
                    </span>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>
