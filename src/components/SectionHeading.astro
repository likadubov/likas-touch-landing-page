---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "start";
  class?: string;
}

const { eyebrow, title, subtitle, align = "center", class: className = "" } = Astro.props;

const alignClasses = align === "center" ? "items-center text-center mx-auto" : "items-start text-start";
---

<div class={`reveal flex max-w-2xl flex-col gap-4 ${alignClasses} ${className}`}>
  {eyebrow && (
    <span class="inline-flex items-center gap-2 self-auto rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 font-mono text-sm font-medium uppercase tracking-[0.12em] text-pink-soft">
      <span class="h-1.5 w-1.5 rounded-full bg-pink shadow-[0_0_8px_var(--color-pink)]"></span>
      {eyebrow}
    </span>
  )}
  <h2 class="text-balance text-3xl font-bold leading-[1.15] text-paper sm:text-4xl md:text-5xl">
    {title}
  </h2>
  {subtitle && <p class="text-balance text-base leading-relaxed text-muted sm:text-lg">{subtitle}</p>}
</div>
