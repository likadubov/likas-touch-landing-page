---
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
import { WHATSAPP_LINK } from "../lib/site";
---

<a
  href={WHATSAPP_LINK}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="דברו איתנו בוואטסאפ"
  class="group fixed bottom-6 end-6 z-50 flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-4 text-white shadow-[0_0_32px_-6px_rgba(37,211,102,0.7)] transition-transform duration-300 hover:scale-105 sm:end-8 sm:bottom-8"
>
  <WhatsAppIcon class="h-7 w-7" />
  <span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-semibold transition-all duration-300 group-hover:max-w-[9rem] group-hover:ps-1">
    דברו איתנו
  </span>
  <span class="absolute inset-0 -z-10 rounded-full bg-[#25D366] opacity-60 animate-pulse-soft"></span>
</a>
