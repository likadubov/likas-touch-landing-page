---
import { NAV_LINKS, PHONE_DISPLAY, WHATSAPP_LINK } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="glow-line relative border-t border-white/10 bg-noir-2 pt-16 pb-8">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-12 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <span class="text-xl font-bold tracking-tight text-paper">
          Lika<span class="text-pink">'</span>s Touch
        </span>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          סטודיו דיגיטלי ו-AI לעסקים קטנים — עיצוב דפי נחיתה, עיצוב לרשתות חברתיות ואוטומציות AI, בגישה אישית ובתשומת לב לפרטים.
        </p>
      </div>

      <div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
        <div>
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-muted">ניווט</h3>
          <ul class="mt-4 flex flex-col gap-2.5">
            {NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-paper/80 transition-colors hover:text-pink-soft">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-muted">יצירת קשר</h3>
          <ul class="mt-4 flex flex-col gap-2.5">
            <li>
              <a
                href={WHATSAPP_LINK}
                target="_blank"
                rel="noopener noreferrer"
                dir="ltr"
                class="text-sm text-paper/80 transition-colors hover:text-pink-soft"
              >
                {PHONE_DISPLAY}
                <span class="sr-only"> (נפתח בוואטסאפ בטאב חדש)</span>
              </a>
            </li>
            <li class="text-sm text-paper/80">ישראל · עבודה מרחוק</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-xs text-muted">© {year} Lika's Touch. כל הזכויות שמורות.</p>
      <div class="flex items-center gap-4">
        <a href="/accessibility" class="text-xs text-muted transition-colors hover:text-pink-soft">הצהרת נגישות</a>
        <p class="text-xs text-muted">נבנה עם דיוק, קוד וטיפה של נגיעה אישית.</p>
      </div>
    </div>
  </div>
</footer>
